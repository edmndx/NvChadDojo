{
  "name": "vimdojo",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "catalog:generate": "node --experimental-strip-types scripts/generate-catalog.mjs",
    "predev": "npm run catalog:generate",
    "dev": "vite",
    "prebuild": "npm run catalog:generate",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b",
    "lint": "oxlint src scripts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "size": "node scripts/check-bundle-size.mjs",
    "check": "npm run typecheck && npm run lint && npm run format:check && npm run build && npm run size"
  },
  "dependencies": {
    "lucide-react": "1.31.0",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@types/node": "^26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitejs/plugin-react": "6.0.5",
    "oxlint": "^1.78.0",
    "prettier": "^3.9.6",
    "typescript": "7.0.2",
    "vite": "8.2.1"
  }
}
